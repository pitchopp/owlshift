# Test fixtures and generated schemas are compared byte for byte: keep LF on
# every platform, whatever core.autocrlf says.
crates/owlshift-contracts/tests/fixtures/** text eol=lf
schemas/*.json text eol=lf
tests/scenarios/** text eol=lf
crates/owlshift-adapters/tests/fixtures/codex/** text eol=lf
# Signed by minisign: one byte changed breaks the signature (OWL-541).
crates/owlshift-cli/tests/fixtures/self-update/** text eol=lf
# Shell scripts run as they are checked out, the install script by `sh`
# straight from the repository (OWL-540).
*.sh text eol=lf
